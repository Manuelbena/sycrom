<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_home">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/lyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clHeaderContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small">

            <TextView
                android:id="@+id/textGreeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunitoextrabold"
                android:text="@string/home_greeting_placeholder"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="@dimen/text_h5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/lyWeatherActions"
                tools:text="Hola, Manuel" />

            <TextView
                android:id="@+id/textDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunitosemibold"
                android:text="@string/home_date_placeholder"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/text_body"
                app:layout_constraintStart_toStartOf="@id/textGreeting"
                app:layout_constraintTop_toBottomOf="@id/textGreeting"
                tools:text="12 de mayo de 2025" />

            <LinearLayout
                android:id="@+id/lyWeatherActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/textDate">

                <LinearLayout
                    android:id="@+id/lyWeatherWidget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/spacing_s">

                    <ImageView
                        android:id="@+id/iconWeather"
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_sol"
                        app:tint="@color/md_theme_onSurface" />

                    <TextView
                        android:id="@+id/textTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:fontFamily="@font/nunitobold"
                        android:textColor="@color/md_theme_onSurface"
                        tools:text="17°C" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_settings" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/lyHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Columna Izquierda: Calendario y Resumen -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <LinearLayout
                        android:id="@+id/lyCalendarContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/md_theme_surface"
                        android:padding="@dimen/spacing_small">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/tvMonthYear"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/nunitobold"
                                android:textSize="@dimen/text_h2" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnToday"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_btn_today" />
                        </LinearLayout>

                        <com.kizitonwose.calendar.view.WeekCalendarView
                            android:id="@+id/weekCalendarView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cv_dayViewResource="@layout/item_calendar_day_new" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardQuote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        app:cardBackgroundColor="@color/color_card"
                        app:cardCornerRadius="@dimen/card_corner_radius_lg"
                        app:cardElevation="@dimen/card_elevation_m3">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_medium">
                            <TextView
                                android:id="@+id/tvQuoteText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunitosemibold"
                                android:textColor="@color/md_theme_onSurface"
                                android:textSize="@dimen/text_body" />
                            <TextView
                                android:id="@+id/tvQuoteAuthor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunitobold"
                                android:textColor="@color/secondary_text"
                                android:textSize="@dimen/text_caption"
                                android:gravity="end" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardProd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        app:cardBackgroundColor="@color/color_card"
                        app:cardCornerRadius="@dimen/card_corner_radius_lg"
                        app:cardElevation="@dimen/card_elevation_m3">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/spacing_small">

                            <ImageView
                                android:id="@+id/ivProdIcon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_cicle_purpple"
                                android:padding="6dp"
                                android:src="@drawable/ic_finance"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="?attr/colorSurface" />

                            <TextView
                                android:id="@+id/tvProdTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_s"
                                android:fontFamily="@font/nunitosemibold"
                                android:text="@string/home_card_prod_title"
                                android:textColor="@color/secondary_text"
                                android:textSize="@dimen/text_caption"
                                app:layout_constraintBottom_toBottomOf="@+id/ivProdIcon"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/ivProdIcon"
                                app:layout_constraintTop_toTopOf="@+id/ivProdIcon" />

                            <TextView
                                android:id="@+id/tvProdValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_small"
                                android:fontFamily="@font/nunitoextrabold"
                                android:textColor="@color/secondary_text"
                                android:textSize="@dimen/text_h6"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/ivProdIcon" />

                            <TextView
                                android:id="@+id/tvProdSubtitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunitregular"
                                android:text="@string/home_card_prod_subtitle"
                                android:textColor="@color/secondary_text"
                                android:textSize="10sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tvProdValue" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        app:cardBackgroundColor="@color/color_card"
                        app:cardCornerRadius="@dimen/card_corner_radius_lg"
                        app:cardElevation="@dimen/card_elevation_m3">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/spacing_small">

                            <ImageView
                                android:id="@+id/ivBalanceIcon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_cicle_blue"
                                android:padding="6dp"
                                android:src="@drawable/ic_banck"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="?attr/colorSurface" />

                            <TextView
                                android:id="@+id/tvBalanceTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_s"
                                android:fontFamily="@font/nunitosemibold"
                                android:text="@string/home_card_balance_title"
                                android:textColor="@color/secondary_text"
                                android:textSize="@dimen/text_caption"
                                app:layout_constraintBottom_toBottomOf="@+id/ivBalanceIcon"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/ivBalanceIcon"
                                app:layout_constraintTop_toTopOf="@+id/ivBalanceIcon" />

                            <TextView
                                android:id="@+id/tvBalanceValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_small"
                                android:fontFamily="@font/nunitoextrabold"
                                android:textColor="@color/secondary_text"
                                android:textSize="@dimen/text_h6"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/ivBalanceIcon" />

                            <TextView
                                android:id="@+id/tvBalanceIndicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_tiny"
                                android:fontFamily="@font/nunitobold"
                                android:textSize="10sp"
                                app:layout_constraintBaseline_toBaselineOf="@+id/tvBalanceValue"
                                app:layout_constraintStart_toEndOf="@+id/tvBalanceValue" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="1dp"
                android:layout_height="match_parent" />

            <!-- Columna Derecha: Tareas -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunitoextrabold"
                        android:text="@string/home_tasks_title"
                        android:textSize="@dimen/text_h2" />

                    <LinearLayout
                        android:id="@+id/lySuperTasksContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/nunitoextrabold"
                            android:text="Super Tareas"
                            android:textSize="18sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvSuperTasks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </LinearLayout>

                    <com.google.android.material.loadingindicator.LoadingIndicator
                        android:id="@+id/progress_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmerViewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <include layout="@layout/layout_skeleton_task" />
                            <include layout="@layout/layout_skeleton_task" />
                        </LinearLayout>
                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <LinearLayout
                        android:id="@+id/ivNoTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:src="@drawable/synkrom_sintareas" />
                        <TextView
                            android:id="@+id/tvNoTasks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:gravity="center"
                            android:text="@string/home_tasks_empty_title" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- FABs stay at bottom right -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/tvFabAddGasto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:fontFamily="@font/nunitobold"
        android:text="@string/fab_expense"
        android:textColor="@color/white"
        android:visibility="invisible"
        app:backgroundTint="@color/md_theme_primary"
        app:icon="@drawable/banknote_arrow_down"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/tvFabAddIng"
        app:layout_constraintEnd_toEndOf="@+id/tvFabAddIng" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/tvFabAddIng"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:fontFamily="@font/nunitobold"
        android:text="@string/fab_income"
        android:textColor="@color/white"
        android:visibility="invisible"
        app:backgroundTint="@color/md_theme_primary"
        app:icon="@drawable/banknote_arrow_up"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/tvFabAddSuggestion"
        app:layout_constraintEnd_toEndOf="@+id/tvFabAddSuggestion" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/tvFabAddSuggestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:fontFamily="@font/nunitobold"
        android:text="@string/fab_task_ai"
        android:textColor="@color/white"
        android:visibility="invisible"
        app:backgroundTint="@color/md_theme_primary"
        app:icon="@drawable/sparkle"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/tvFabAddTask"
        app:layout_constraintEnd_toEndOf="@+id/tvFabAddTask" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/tvFabAddTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:fontFamily="@font/nunitobold"
        android:text="@string/fab_task"
        android:textColor="@color/white"
        android:visibility="invisible"
        app:backgroundTint="@color/md_theme_primary"
        app:icon="@drawable/ic_edit"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/fabMain"
        app:layout_constraintEnd_toEndOf="@+id/fabMain" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_large"
        android:layout_marginBottom="32dp"
        android:contentDescription="Abrir menú"
        app:backgroundTint="@color/md_theme_primary"
        app:elevation="6dp"
        app:fabSize="normal"
        app:srcCompat="@drawable/ic_plus"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>