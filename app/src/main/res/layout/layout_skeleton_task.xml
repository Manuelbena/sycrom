<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_body"
    android:layout_marginBottom="@dimen/space_card_width"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp">

        <!-- EXPERT VIEW: Resumen Ejecutivo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_main_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#F3F4F6"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_main_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunitobold"
                    android:text="Resumen"
                    android:textColor="#111827"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="@+id/btn_add_budget"
                    app:layout_constraintEnd_toStartOf="@+id/btn_add_budget"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/btn_add_budget" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_budget"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="#F3E8FF"
                    android:fontFamily="@font/nunitobold"
                    android:text="Presupuesto"
                    android:textAllCaps="false"
                    android:textColor="#8B5CF6"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_plus"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="14dp"
                    app:iconTint="#8B5CF6"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/lpi_total_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    app:indicatorColor="#8B5CF6"
                    app:layout_constraintTop_toBottomOf="@id/btn_add_budget"
                    app:trackColor="#F3F4F6"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="16dp"
                    tools:progress="65" />

                <LinearLayout
                    android:id="@+id/ly_progress_labels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/lpi_total_progress">

                    <TextView
                        android:id="@+id/tv_total_spent_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunitosemibold"
                        android:text="Gastado: 850 €"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_total_limit_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunitosemibold"
                        android:text="Límite: 1.200 €"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/container_donut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ly_progress_labels">

                                    <com.manuelbena.synkron.presentation.components.FinancePiePorcentel
                        android:id="@+id/cpi_donut_chart"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="center" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_donut_balance_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunitosemibold"
                            android:text="Balance"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_donut_balance_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunitobold"
                            android:textColor="#10B981"
                            android:textSize="20sp"
                            tools:text="1.200 €" />
                    </LinearLayout>
                </FrameLayout>

                <!-- INSIGHT CARD: Información procesada para el usuario -->
                <LinearLayout
                    android:id="@+id/ly_insight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="#F9FAFB"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/container_donut">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_finance"
                        app:tint="#8B5CF6" />

                    <TextView
                        android:id="@+id/tv_top_insight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/nunitosemibold"
                        android:text="Analizando tus gastos..."
                        android:textColor="#4B5563"
                        android:textSize="13sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ranking Label -->
        <TextView
            android:id="@+id/tv_ranking_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/nunitobold"
            android:text="Ranking por Gasto"
            android:textColor="#374151"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_main_summary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_budget_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tv_ranking_label"
            tools:itemCount="3"
            tools:listitem="@layout/item_budget_category" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>