<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- El color de fondo acorde a color_card (Slate 800 en noche) -->
        <item name="windowSplashScreenBackground">@color/color_card</item>

        <!-- El icono central (Icono de la App) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <item name="windowSplashScreenAnimationDuration">200</item>

        <!-- El tema al que cambiará después de cargar -->
        <item name="postSplashScreenTheme">@style/Theme.Sycrom</item>
    </style>
</resources>